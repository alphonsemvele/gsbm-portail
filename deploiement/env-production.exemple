# Fichier .env du SERVEUR (gsbm.lamajestueuse.com).
# À copier en .env à la racine de l'application, puis à compléter.
# Il n'est jamais envoyé par le pipeline : il reste sur le serveur.

APP_NAME="GSBM"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://gsbm.lamajestueuse.com

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

# Journaux : un fichier par jour, seulement les erreurs.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
# Le site est en HTTPS : le cookie de session ne doit pas circuler en clair.
SESSION_SECURE_COOKIE=true

QUEUE_CONNECTION=database
CACHE_STORE=database

# Relais d'envoi : les mêmes réglages que le portail du groupe.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="info@lamajestueuse.com"
MAIL_FROM_NAME="GSBM"

# Identite de l'etablissement. Le code est commun a IUM, IFPM et GSBM :
# sans ces valeurs, le site s'affiche sous celle d'IUM, qui est la valeur
# par defaut du code.
ETABLISSEMENT_SIGLE="GSBM NDAZOA"
ETABLISSEMENT_NOM="Groupe Scolaire Bilingue La Majestueuse"
ETABLISSEMENT_SLOGAN="Un avenir brillant commence ici."
ETABLISSEMENT_ADRESSE="Mbankomo, Ndazoa — Yaoundé, Cameroun"
ETABLISSEMENT_TELEPHONE="+237 699 123 456"
ETABLISSEMENT_EMAIL=info@gsbm-ndazoa.com
ETABLISSEMENT_DOMAINE=gsbm-ndazoa.com
ETABLISSEMENT_LOGO=images/logo.png
LIBELLE_CYCLE="Cycles"
LIBELLE_CYCLE_AIDE="Maternelle, Primaire"
LIBELLE_DEPARTEMENT="Sections"
LIBELLE_DEPARTEMENT_AIDE="Francophone, anglophone"
LIBELLE_FILIERE="Niveaux"
LIBELLE_FILIERE_AIDE="Cycles par section"
LIBELLE_SPECIALITE="Classes"
LIBELLE_SPECIALITE_AIDE="PS à CM2, Nursery à Class 6"
LIBELLE_UE="Domaines"
LIBELLE_UE_AIDE="Domaines d apprentissage"
LIBELLE_ETUDIANTS="Élèves"
ETABLISSEMENT_MODULE_INSCRIPTIONS=true
